<!-- Must pass: a ternary table of supports with stars. Optimum: 7. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..3 </var>
    <var id="y"> 0..3 </var>
    <var id="z"> 0..3 </var>
  </variables>
  <constraints>
    <extension>
      <list> x y z </list>
      <supports> (0,*,3)(*,2,1)(1,*,3) </supports>
    </extension>
  </constraints>
  <objectives>
    <maximize type="sum">
      <list> x y z </list>
    </maximize>
  </objectives>
</instance>
