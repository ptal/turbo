<!-- Must pass: `element` over a list of integers with startIndex 1; the index domain is larger than the list. Optimum: 330. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="i"> 0..5 </var>
    <var id="v"> 0..50 </var>
  </variables>
  <constraints>
    <element>
      <list startIndex="1"> 10 20 30 </list>
      <index> i </index>
      <value> v </value>
    </element>
  </constraints>
  <objectives>
    <maximize type="sum">
      <list> i v </list>
      <coeffs> 100 1 </coeffs>
    </maximize>
  </objectives>
</instance>
