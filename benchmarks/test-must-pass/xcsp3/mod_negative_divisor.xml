<!-- Must pass: `mod` by a negative divisor has the sign of the dividend. Optimum: 2. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 5..7 </var>
    <var id="y"> -3..-2 </var>
    <var id="z"> -5..5 </var>
  </variables>
  <constraints>
    <intension> eq(mod(x,y),z) </intension>
  </constraints>
  <objectives>
    <maximize> z </maximize>
  </objectives>
</instance>
