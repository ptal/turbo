<!-- Must pass: `eq(add(x,y),z)`, recognized as the sum x + y - z = 0. Optimum: 7. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..4 </var>
    <var id="y"> 1..3 </var>
    <var id="z"> 0..10 </var>
  </variables>
  <constraints>
    <intension> eq(add(x,y),z) </intension>
  </constraints>
  <objectives>
    <maximize> z </maximize>
  </objectives>
</instance>
