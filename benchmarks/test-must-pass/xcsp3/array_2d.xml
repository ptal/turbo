<!-- Must pass: a two-dimensional array with row lists `m[0][]` and column lists `m[][0]`. Optimum: 6. -->
<instance format="XCSP3" type="COP">
  <variables>
    <array id="m" size="[2][2]"> 1..3 </array>
  </variables>
  <constraints>
    <allDifferent> m[0][] </allDifferent>
    <allDifferent> m[1][] </allDifferent>
    <allDifferent> m[][0] </allDifferent>
    <allDifferent> m[][1] </allDifferent>
  </constraints>
  <objectives>
    <maximize type="sum">
      <list> m[0][0] m[1][1] </list>
    </maximize>
  </objectives>
</instance>
