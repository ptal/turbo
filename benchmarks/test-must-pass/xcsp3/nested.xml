<!-- Must pass: a deeply nested arithmetic expression. Optimum: 4. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..4 </var>
    <var id="y"> 0..4 </var>
    <var id="z"> -5..5 </var>
  </variables>
  <constraints>
    <intension> le(add(mul(2,x),mul(3,y),neg(z)),max(x,y)) </intension>
  </constraints>
  <objectives>
    <maximize type="sum">
      <list> x y </list>
    </maximize>
  </objectives>
</instance>
