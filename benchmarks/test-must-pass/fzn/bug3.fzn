var bool: b_0 :: output_var;
var bool: b_1 :: output_var;
var bool: b_3 :: output_var;
var bool: b_4 :: output_var;
var -10..10: y :: output_var;

constraint int_min(bool2int(b_3),bool2int(b_4),1);
constraint int_min(bool2int(b_0),bool2int(b_1),1);
constraint bool_eq(b_3,int_le(0,y));
constraint bool_eq(b_4,int_le(y,5));
solve minimize y;