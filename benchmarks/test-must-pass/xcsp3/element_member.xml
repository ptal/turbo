<!-- Must pass: `element` without index: some variable of the list equals the value. Optimum: 4. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..5 </var>
    <var id="y"> 0..5 </var>
    <var id="z"> 0..5 </var>
  </variables>
  <constraints>
    <element>
      <list> x y z </list>
      <value> 4 </value>
    </element>
  </constraints>
  <objectives>
    <minimize type="sum">
      <list> x y z </list>
    </minimize>
  </objectives>
</instance>
