<!-- Must pass: `element` over a matrix with startRowIndex 1 and startColIndex 1; the index domains are larger than the matrix. Optimum: 236. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="r"> 0..3 </var>
    <var id="c"> 0..4 </var>
    <var id="v"> 0..9 </var>
  </variables>
  <constraints>
    <element>
      <matrix startRowIndex="1" startColIndex="1"> (1,2,3)(4,5,6) </matrix>
      <index> r c </index>
      <value> v </value>
    </element>
  </constraints>
  <objectives>
    <maximize type="sum">
      <list> r c v </list>
      <coeffs> 100 10 1 </coeffs>
    </maximize>
  </objectives>
</instance>
