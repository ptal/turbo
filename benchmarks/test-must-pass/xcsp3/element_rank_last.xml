<!-- Must pass: `element` whose index has rank last, with a constant value. Optimum: 2. -->
<instance format="XCSP3" type="COP">
  <variables>
    <array id="x" size="[5]"> 0..2 </array>
    <var id="i"> 0..4 </var>
  </variables>
  <constraints>
    <intension> eq(x[0],2) </intension>
    <intension> eq(x[1],0) </intension>
    <intension> eq(x[2],2) </intension>
    <intension> eq(x[3],1) </intension>
    <intension> eq(x[4],0) </intension>
    <element>
      <list> x[] </list>
      <index rank="last"> i </index>
      <value> 2 </value>
    </element>
  </constraints>
  <objectives>
    <minimize> i </minimize>
  </objectives>
</instance>
