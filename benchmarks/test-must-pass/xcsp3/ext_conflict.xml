<!-- Must pass: a binary table of conflicts. Optimum: 4. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..3 </var>
    <var id="y"> 0..3 </var>
  </variables>
  <constraints>
    <extension>
      <list> x y </list>
      <conflicts> (3,3)(3,2)(2,3) </conflicts>
    </extension>
  </constraints>
  <objectives>
    <maximize type="sum">
      <list> x y </list>
    </maximize>
  </objectives>
</instance>
