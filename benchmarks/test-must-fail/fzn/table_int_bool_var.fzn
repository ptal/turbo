% Must fail: a Boolean variable is in the header of an integer table constraint.
% expect: `zeq` expects an argument of sort Int, but argument 1 has sort Bool (use `bool2int` to convert a Boolean into an integer).
var 1..3: x;
var bool: b;
constraint turbo_fzn_table_int(true, [x, b], [1, 2, 3, 4]);
solve satisfy;
