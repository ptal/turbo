<!-- Must pass: constraints inside a `block`. Optimum: 5. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..3 </var>
    <var id="y"> 0..3 </var>
    <var id="z"> 0..3 </var>
  </variables>
  <constraints>
    <block class="channeling">
      <intension> eq(x,add(y,1)) </intension>
      <allDifferent> x y z </allDifferent>
    </block>
  </constraints>
  <objectives>
    <maximize type="sum">
      <list> x z </list>
    </maximize>
  </objectives>
</instance>
