<!-- Must pass: a group of intension constraints with arguments `%0` and `%1`. Optimum: 2. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..4 </var>
    <var id="y"> 0..4 </var>
    <var id="z"> 0..4 </var>
  </variables>
  <constraints>
    <group>
      <intension> lt(%0,%1) </intension>
      <args> x y </args>
      <args> y z </args>
    </group>
  </constraints>
  <objectives>
    <maximize> x </maximize>
  </objectives>
</instance>
