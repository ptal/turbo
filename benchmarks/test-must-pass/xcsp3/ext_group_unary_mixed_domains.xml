<!-- Must pass: a group of unary tables whose variables do not all have the same domain, so the tuples are sent again for z. Optimum: 6. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..3 </var>
    <var id="y"> 0..3 </var>
    <var id="z"> 0..5 </var>
  </variables>
  <constraints>
    <group>
      <extension>
        <list> %0 </list>
        <supports> 1 4 </supports>
      </extension>
      <args> x </args>
      <args> y </args>
      <args> z </args>
    </group>
  </constraints>
  <objectives>
    <maximize type="sum">
      <list> x y z </list>
    </maximize>
  </objectives>
</instance>
