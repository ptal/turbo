<!-- Must pass: `lt(x,y)`, recognized as the primitive x + 0 < y. Optimum: 4. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..5 </var>
    <var id="y"> 0..5 </var>
  </variables>
  <constraints>
    <intension> lt(x,y) </intension>
  </constraints>
  <objectives>
    <maximize> x </maximize>
  </objectives>
</instance>
