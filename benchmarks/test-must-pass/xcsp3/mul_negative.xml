<!-- Must pass: a product of two variables equal to a negative constant. Optimum: 3. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> -3..3 </var>
    <var id="y"> -3..3 </var>
  </variables>
  <constraints>
    <intension> eq(mul(x,y),-6) </intension>
  </constraints>
  <objectives>
    <maximize> x </maximize>
  </objectives>
</instance>
