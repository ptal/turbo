<!-- Must pass: a unary table of conflicts with two values. Optimum: 4. -->
<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..6 </var>
  </variables>
  <constraints>
    <extension>
      <list> x </list>
      <conflicts> 5 6 </conflicts>
    </extension>
  </constraints>
  <objectives>
    <maximize> x </maximize>
  </objectives>
</instance>
